# PatrolIQ — Environment Variables
# Copy this file to .env and fill in values

# MLflow tracking URI (local SQLite)
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Raw data path (fill in after downloading from Chicago Data Portal)
RAW_DATA_PATH=data/raw/chicago_crimes.csv

# Streamlit server settings (optional overrides)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
