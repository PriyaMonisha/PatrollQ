# PatrolIQ — Environment Variables
# Copy to .env and customise. Never commit .env to git.

# ── Data paths ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
DATA_PATH=./data/processed/chicago_crime_500k.csv.gz
ARTIFACTS_DIR=./artifacts
PROCESSED_DIR=./data/processed

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── FAST_MODE: true = 50K dev sample, false = full 500K production pipeline
FAST_MODE=false

# ── Security ─────────────────────────────────────────────────
# API key for /v1/predict and /v1/drift endpoints. Leave empty to disable (dev only).
PATROLIQ_API_KEY=
# Restrict CORS to known frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501
# Grafana admin password — MUST be changed before production deployment
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# ── FastAPI server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit server ──────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Raw data (fill in after downloading from Chicago Data Portal)
RAW_DATA_PATH=data/raw/Crimes_-_2001_to_Present.csv
