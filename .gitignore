# ── Data (large files) ───────────────────────────────────────
# IMPORTANT: use leading slash to anchor to project root ONLY
# Without /: "data/raw/" would also match "src/data/raw/" — excludes source files!
# Lesson learned from EMI project (DEP-01): always anchor data patterns with /
/data/raw/
/mlruns/

# ── Model artifacts (regenerated by pipeline) ─────────────────
models/*.pkl
models/*.joblib

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Streamlit ────────────────────────────────────────────────
.streamlit/secrets.toml
